---
import BaseLayout from '../layouts/BaseLayout.astro'

const pageTitle = 'Notes on software and the web'
const latestPosts = Object.values(
  import.meta.glob('/src/pages/articles/*.{md,mdx}', { eager: true }),
).sort((a, b) => Date.parse(b.frontmatter.pubDate ?? '') - Date.parse(a.frontmatter.pubDate ?? ''))
---

<BaseLayout pageTitle={pageTitle}>
  <div class="not-prose">
    <section class="mb-16 max-w-2xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">
        A developer's notebook
      </p>
      <p class="text-lg leading-relaxed text-gray-300 sm:text-xl">
        Practical notes and lessons from building for the web — exploring software, tools, and the
        craft behind them.
      </p>
      <a
        class="mt-6 inline-flex items-center gap-2 font-semibold text-sky-300 transition hover:text-cyan-200"
        href="/articles/"
      >
        Browse all articles <span aria-hidden="true">&rarr;</span>
      </a>
    </section>

    <section aria-labelledby="latest-heading">
      <div class="mb-5 flex items-center justify-between border-b border-slate-700 pb-3">
        <h2 id="latest-heading" class="m-0 text-xl font-semibold text-gray-100">Latest writing</h2>
        <a class="text-sm text-gray-400 transition hover:text-cyan-200" href="/articles/">
          View all
        </a>
      </div>

      {latestPosts.length > 0 ? (
        <div class="divide-y divide-slate-700">
          {latestPosts.map((post) => (
            <article class="grid gap-5 py-6 sm:grid-cols-[minmax(0,1fr)_12rem] sm:items-center">
              <div>
                <p class="mb-2 text-sm text-gray-400">
                  {post.frontmatter.pubDate?.slice(0, 10)}
                  {post.frontmatter.tags?.[0] && (
                    <span class="ml-3 text-cyan-300">/ {post.frontmatter.tags[0]}</span>
                  )}
                </p>
                <h3 class="mb-2 text-2xl font-semibold leading-snug text-gray-100">
                  <a
                    class="transition hover:text-cyan-200"
                    href={post.url}
                  >
                    {post.frontmatter.title}
                  </a>
                </h3>
                <p class="m-0 text-gray-400">
                  By {post.frontmatter.author}
                </p>
              </div>
              {post.frontmatter.image?.url && (
                <a class="block overflow-hidden rounded-lg" href={post.url} tabindex="-1" aria-hidden="true">
                  <img
                    class="aspect-[16/10] w-full object-cover transition duration-300 hover:scale-105"
                    src={post.frontmatter.image.url}
                    alt=""
                    loading="lazy"
                  />
                </a>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="py-6 text-gray-400">New writing is on the way.</p>
      )}
    </section>
  </div>
</BaseLayout>
